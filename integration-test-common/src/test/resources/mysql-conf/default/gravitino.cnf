# Gravitino's MySQL test containers use this file instead of the small one Testcontainers 1.x
# bundles, so the server runs with the image's defaults apart from what is set here.
[mysqld]
# The image default, pinned: TestRoleMembershipWrites and TestOwnerAssignmentWrites poll
# performance_schema.data_lock_waits to see a blocked writer.
performance_schema = ON
