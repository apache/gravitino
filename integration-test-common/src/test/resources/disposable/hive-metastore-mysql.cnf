# Gravitino's Hive test containers copy this file into the image's MySQL 5.7, the Hive metastore
# database, when test data is disposable. The database is rebuilt at every container start, so the
# server skips crash-safety work. The data directory stays on disk: a tmpfs over it would hide the
# system tables the image was built with.
[mysqld]
# Write and flush the redo log once a second instead of at each commit.
innodb_flush_log_at_trx_commit = 0
innodb_doublewrite = OFF
