<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- Formatting is enforced by Spotless; Checkstyle only holds rules Spotless cannot express. -->
<module name="Checker">
  <property name="severity" value="error"/>
  <module name="TreeWalker">
    <!-- Tests use JUnit Jupiter only: ban JUnit 4 (org.junit.*, static imports too) outside
         org.junit.jupiter and org.junit.platform. An empty illegalPkgs drops the default sun.* ban. -->
    <module name="IllegalImport">
      <property name="regexp" value="true"/>
      <property name="illegalPkgs" value=""/>
      <property name="illegalClasses" value="^org\.junit\.(?!jupiter\.|platform\.).*"/>
    </module>
  </module>
</module>
