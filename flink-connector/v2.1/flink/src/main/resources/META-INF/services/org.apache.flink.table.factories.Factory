# Hive catalog support is intentionally omitted for Flink 2.1: no flink-connector-hive release
# targets the Flink 2.x line yet (tracked upstream as FLINK-38031), and the newest available
# release (built against 1.20) fails at runtime on Flink 2.x because it references
# org.apache.flink.api.java.hadoop.mapred.utils.HadoopUtils, a class removed along with the
# DataSet API. Revisit once flink-connector-hive ships a Flink 2.x-compatible release.
org.apache.gravitino.flink.connector.paimon.GravitinoPaimonCatalogFactoryFlink21
org.apache.gravitino.flink.connector.iceberg.GravitinoIcebergCatalogFactoryFlink21
org.apache.gravitino.flink.connector.jdbc.mysql.GravitinoMysqlJdbcCatalogFactoryFlink21
org.apache.gravitino.flink.connector.jdbc.postgresql.GravitinoPostgresJdbcCatalogFactoryFlink21
org.apache.gravitino.flink.connector.store.GravitinoCatalogStoreFactory
