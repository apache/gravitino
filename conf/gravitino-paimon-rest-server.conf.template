# THE CONFIGURATION FOR Paimon REST SERVER
# Standalone mode uses its configured service account for Gravitino catalog lookups.
# Use auxiliary mode with dynamic-config-provider for per-request metadata authorization.
# THE CONFIGURATION FOR Paimon REST WEB SERVER
# The host name of the built-in web server
gravitino.paimon-rest.host = 0.0.0.0
# The http port number of the built-in web server
gravitino.paimon-rest.httpPort = 9002
# The min thread size of the built-in web server
gravitino.paimon-rest.minThreads = 24
# The max thread size of the built-in web server
gravitino.paimon-rest.maxThreads = 200
# The stop timeout of the built-in web server
gravitino.paimon-rest.stopTimeout = 30000
# The timeout of idle connections
gravitino.paimon-rest.idleTimeout = 30000
# The executor thread pool work queue size of the built-in web server
gravitino.paimon-rest.threadPoolWorkQueueSize = 100
# The request header size of the built-in web server
gravitino.paimon-rest.requestHeaderSize = 131072
# The response header size of the built-in web server
gravitino.paimon-rest.responseHeaderSize = 131072

# THE CONFIGURATION FOR Paimon catalog backend
# The Paimon catalog backend, one of filesystem, jdbc or hive
gravitino.paimon-rest.catalog-backend = filesystem
# The warehouse directory of the Paimon catalog
gravitino.paimon-rest.warehouse = /tmp/paimon-warehouse

# Bearer tokens: one token per principal (revocable individually), or one shared token
# gravitino.paimon-rest.token.<principal> = <token>
# gravitino.paimon-rest.token = <shared-token>

# OAuth JWT validation with an identity provider's JWKS endpoint. Leave the static tokens unset.
# gravitino.authenticators = oauth
# gravitino.authenticator.oauth.tokenValidatorClass = org.apache.gravitino.server.authentication.JwksTokenValidator
# gravitino.authenticator.oauth.authority = <issuer-url>
# gravitino.authenticator.oauth.jwksUri = <jwks-url>
# gravitino.authenticator.oauth.serviceAudience = <token-audience>

# Forward catalog-wide static storage keys for every table, with a synthetic 2h refresh time.
# Use long-lived keys, without S3/OSS session tokens.
# gravitino.paimon-rest.data-token.enabled = true

# Serve catalogs already registered in a Gravitino metalake.
# gravitino.paimon-rest.catalog-config-provider = dynamic-config-provider
# gravitino.paimon-rest.gravitino-metalake = production
# Dynamic configurations expire after this fixed lifetime, including under continuous traffic.
# gravitino.paimon-rest.catalog-cache-ttl-ms = 30000
# Auxiliary mode uses the in-process CatalogManager and supports Gravitino authorization.
# Standalone mode resolves catalogs as the configured Gravitino service account.
# gravitino.paimon-rest.gravitino-uri = http://127.0.0.1:8090
# gravitino.paimon-rest.gravitino-auth-type = simple
# gravitino.paimon-rest.gravitino-simple.user-name = paimon-rest-server
# OAuth client credentials for the outgoing Gravitino client.
# gravitino.paimon-rest.gravitino-auth-type = oauth2
# gravitino.paimon-rest.gravitino-oauth2.server-uri = https://identity.example.com
# gravitino.paimon-rest.gravitino-oauth2.credential = <client-id>:<client-secret>
# gravitino.paimon-rest.gravitino-oauth2.token-path = oauth/token
# gravitino.paimon-rest.gravitino-oauth2.scope = <scope>
# S3/OSS token providers issue read/write STS credentials scoped to the catalog warehouse.
# STS failures fail catalog resolution. Standalone mode uses the resolved catalog secrets.
# Dynamic data-token catalogs need credentials with well over one hour remaining.
# Set s3-token-expire-in-secs / oss-token-expire-in-secs on the Gravitino catalog, e.g. 7200.
# S3 role chaining is limited to 3600s and cannot satisfy this data-token refresh window.
# A 7200s S3 session requires a caller and role that permit at least a two-hour session.

# THE CONFIGURATION EXAMPLE FOR JDBC CATALOG BACKEND
# gravitino.paimon-rest.catalog-backend = jdbc
# gravitino.paimon-rest.uri = jdbc:postgresql://127.0.0.1:5432/postgres
# gravitino.paimon-rest.jdbc-driver = org.postgresql.Driver
# gravitino.paimon-rest.jdbc-user = postgres
# gravitino.paimon-rest.jdbc-password = abc123
# gravitino.paimon-rest.warehouse = /tmp/paimon-warehouse
