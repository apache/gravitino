<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.apache.gravitino.storage.relational.mapper.ModelVersionMetaMapper">
  <resultMap id="modelVersionSnapshot" type="org.apache.gravitino.storage.relational.po.ModelVersionSnapshotPO">
    <id property="modelId" column="root_model_id"/>
    <collection property="modelVersions" ofType="org.apache.gravitino.storage.relational.po.ModelVersionPO" notNullColumn="version">
      <id property="modelId" column="model_id"/>
      <id property="modelVersion" column="version"/>
      <id property="modelVersionUriName" column="model_version_uri_name"/>
      <result property="metalakeId" column="metalake_id"/>
      <result property="catalogId" column="catalog_id"/>
      <result property="schemaId" column="schema_id"/>
      <result property="modelVersionComment" column="model_version_comment"/>
      <result property="modelVersionProperties" column="model_version_properties"/>
      <result property="modelVersionUri" column="model_version_uri"/>
      <result property="auditInfo" column="audit_info"/>
      <result property="deletedAt" column="deleted_at"/>
    </collection>
    <collection property="aliases" ofType="org.apache.gravitino.storage.relational.po.ModelVersionAliasRelPO" notNullColumn="alias_name">
      <id property="modelId" column="alias_model_id"/>
      <id property="modelVersion" column="alias_version"/>
      <id property="modelVersionAlias" column="alias_name"/>
      <result property="deletedAt" column="alias_deleted_at"/>
    </collection>
  </resultMap>

  <sql id="versionByAlias">
    (SELECT target.model_version FROM model_version_alias_rel target
     WHERE target.model_id = #{modelId} AND target.model_version_alias = #{alias}
       AND target.deleted_at = 0)
  </sql>

  <!-- UNION ALL keeps the result linear in URI and alias rows rather than multiplying them. -->
  <select id="selectModelVersionSnapshot" resultMap="modelVersionSnapshot">
    SELECT m.model_id AS root_model_id, snapshot.*
    FROM model_meta m
    LEFT JOIN (
      SELECT v.model_id AS snapshot_model_id,
             v.model_id, v.metalake_id, v.catalog_id, v.schema_id, v.version,
             v.model_version_comment, v.model_version_properties,
             v.model_version_uri_name, v.model_version_uri, v.audit_info, v.deleted_at,
             NULL AS alias_model_id, NULL AS alias_version,
             NULL AS alias_name, NULL AS alias_deleted_at
      FROM model_version_info v
      WHERE v.model_id = #{modelId} AND v.deleted_at = 0
        <if test="version != null">
          AND v.version = #{version}
        </if>
        <if test="alias != null">
          AND v.version = <include refid="versionByAlias"/>
        </if>
      UNION ALL
      SELECT a.model_id,
             NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL,
             a.model_id, a.model_version, a.model_version_alias, a.deleted_at
      FROM model_version_alias_rel a
      WHERE a.model_id = #{modelId} AND a.deleted_at = 0
        <if test="version != null">
          AND a.model_version = #{version}
        </if>
        <if test="alias != null">
          AND a.model_version = <include refid="versionByAlias"/>
        </if>
    ) snapshot ON snapshot.snapshot_model_id = m.model_id
    WHERE m.model_id = #{modelId} AND m.schema_id = #{schemaId}
      AND m.model_name = #{modelName} AND m.deleted_at = 0
  </select>
</mapper>
