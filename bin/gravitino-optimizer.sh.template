#set -ex
USAGE="-e Usage: bin/gravitino-optimizer.sh [--config <conf-dir>]\n\t
        {cmd}"

if [[ "$1" == "--config" ]]; then
  shift
  conf_dir="$1"
  if [[ ! -d "${conf_dir}" ]]; then
    echo "ERROR : ${conf_dir} is not a directory"
    echo ${USAGE}
    exit 1
  else
    export GRAVITINO_CONF_DIR="${conf_dir}"
  fi
  shift
fi

bin="$(dirname "${BASH_SOURCE-$0}")"
bin="$(cd "${bin}">/dev/null; pwd)"

. "${bin}/common.sh"

check_java_version

HOSTNAME=$(hostname)
GRAVITINO_OPTIMIZER_NAME=org.apache.gravitino.maintenance.optimizer.OptimizerCmd
# Used by log4j2 via -Dgravitino.server.name for log file naming.
GRAVITINO_LOG_NAME=gravitino-optimizer

JAVA_OPTS+=" -Dfile.encoding=UTF-8"
JAVA_OPTS+=" -Dlog4j2.configurationFile=file://${GRAVITINO_CONF_DIR}/log4j2.properties"
JAVA_OPTS+=" -Dgravitino.log.path=${GRAVITINO_LOG_DIR} ${GRAVITINO_MEM}"
JAVA_OPTS+=" -Dgravitino.server.name=${GRAVITINO_LOG_NAME}"
if [[ "$JVM_VERSION" -eq 17 ]]; then
  JAVA_OPTS+=" -XX:+IgnoreUnrecognizedVMOptions"
  JAVA_OPTS+=" --add-opens java.base/java.io=ALL-UNNAMED"
  JAVA_OPTS+=" --add-opens java.base/java.lang.invoke=ALL-UNNAMED"
  JAVA_OPTS+=" --add-opens java.base/java.lang.reflect=ALL-UNNAMED"
  JAVA_OPTS+=" --add-opens java.base/java.lang=ALL-UNNAMED"
  JAVA_OPTS+=" --add-opens java.base/java.math=ALL-UNNAMED"
  JAVA_OPTS+=" --add-opens java.base/java.net=ALL-UNNAMED"
  JAVA_OPTS+=" --add-opens java.base/java.nio=ALL-UNNAMED"
  JAVA_OPTS+=" --add-opens java.base/java.text=ALL-UNNAMED"
  JAVA_OPTS+=" --add-opens java.base/java.time=ALL-UNNAMED"
  JAVA_OPTS+=" --add-opens java.base/java.util.concurrent.atomic=ALL-UNNAMED"
  JAVA_OPTS+=" --add-opens java.base/java.util.concurrent=ALL-UNNAMED"
  JAVA_OPTS+=" --add-opens java.base/java.util.regex=ALL-UNNAMED"
  JAVA_OPTS+=" --add-opens java.base/java.util=ALL-UNNAMED"
  JAVA_OPTS+=" --add-opens java.base/jdk.internal.ref=ALL-UNNAMED"
  JAVA_OPTS+=" --add-opens java.base/jdk.internal.reflect=ALL-UNNAMED"
  JAVA_OPTS+=" --add-opens java.sql/java.sql=ALL-UNNAMED"
  JAVA_OPTS+=" --add-opens java.base/sun.util.calendar=ALL-UNNAMED"
  JAVA_OPTS+=" --add-opens java.base/sun.nio.ch=ALL-UNNAMED"
  JAVA_OPTS+=" --add-opens java.base/sun.nio.cs=ALL-UNNAMED"
  JAVA_OPTS+=" --add-opens java.base/sun.security.action=ALL-UNNAMED"
  JAVA_OPTS+=" --add-opens java.base/sun.util.calendar=ALL-UNNAMED"
  JAVA_OPTS+=" --add-opens java.security.jgss/sun.security.krb5=ALL-UNNAMED"
fi

# Shared runtime jars from root libs/ (exact names). Module jars live in optimizer/libs.
add_root_lib() {
  local jar_path="${GRAVITINO_HOME}/libs/$1"
  if [[ ! -f "${jar_path}" ]]; then
    echo "ERROR: required jar not found: ${jar_path}" >&2
    exit 1
  fi
  GRAVITINO_CLASSPATH="${jar_path}:${GRAVITINO_CLASSPATH}"
}

add_root_lib "commons-collections4-4.4.jar"
add_root_lib "commons-dbcp2-2.11.0.jar"
add_root_lib "commons-io-2.22.0.jar"
add_root_lib "commons-lang3-3.14.0.jar"
add_root_lib "commons-logging-1.2.jar"
add_root_lib "commons-pool2-2.12.0.jar"
add_root_lib "failureaccess-1.0.3.jar"
add_root_lib "gravitino-api-${GRAVITINO_VERSION}.jar"
add_root_lib "gravitino-catalog-common-${GRAVITINO_VERSION}.jar"
add_root_lib "gravitino-common-${GRAVITINO_VERSION}.jar"
add_root_lib "gravitino-core-${GRAVITINO_VERSION}.jar"
add_root_lib "guava-33.8.0-jre.jar"
add_root_lib "h2-2.2.224.jar"
add_root_lib "httpclient5-5.4.4.jar"
add_root_lib "httpcore5-5.4.4.jar"
add_root_lib "httpcore5-h2-5.4.4.jar"
add_root_lib "j2objc-annotations-3.1.jar"
add_root_lib "jackson-annotations-2.15.2.jar"
add_root_lib "jackson-core-2.15.2.jar"
add_root_lib "jackson-databind-2.15.2.jar"
add_root_lib "jackson-datatype-jdk8-2.15.2.jar"
add_root_lib "jackson-datatype-jsr310-2.15.2.jar"
add_root_lib "jakarta.transaction-api-1.3.3.jar"
add_root_lib "jakarta.validation-api-2.0.2.jar"
add_root_lib "jspecify-1.0.1.jar"
add_root_lib "listenablefuture-9999.0-empty-to-avoid-conflict-with-guava.jar"
add_root_lib "log4j-1.2-api-2.25.4.jar"
add_root_lib "log4j-api-2.25.4.jar"
add_root_lib "log4j-core-2.25.4.jar"
add_root_lib "log4j-layout-template-json-2.25.4.jar"
add_root_lib "log4j-slf4j2-impl-2.25.4.jar"
add_root_lib "slf4j-api-2.0.17.jar"

if [ -d "${GRAVITINO_HOME}/optimizer/libs" ]; then
  addJarInDir "${GRAVITINO_HOME}/optimizer/libs"
  addDirToClasspath "${GRAVITINO_HOME}/optimizer/conf"
fi

${JAVA_RUNNER} ${JAVA_OPTS} ${GRAVITINO_DEBUG_OPTS} -cp ${GRAVITINO_CLASSPATH} ${GRAVITINO_OPTIMIZER_NAME} "$@"
