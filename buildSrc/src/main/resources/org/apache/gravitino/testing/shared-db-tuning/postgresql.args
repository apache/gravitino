#
# Extra postgres server args for the shared PostgreSQL test container
# (SharedDbContainerService). One token per line; each pair of
# '-c' / 'key=value' lines becomes one '-c key=value' server arg. Blank
# lines and lines starting with # are ignored.
#
# Same rationale as mysql.args: this container is disposable and torn down
# at the end of every test run, so relaxing crash-durability guarantees and
# skipping long-term maintenance work (autovacuum) is safe here and would
# NOT be safe in production.
-c
fsync=off
-c
synchronous_commit=off
-c
full_page_writes=off
-c
shared_buffers=1GB
-c
max_wal_size=4GB
-c
checkpoint_timeout=1h
-c
autovacuum=off
-c
wal_level=minimal
-c
max_wal_senders=0
